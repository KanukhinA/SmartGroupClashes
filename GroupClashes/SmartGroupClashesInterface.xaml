<UserControl x:Class="SmartGroupClashes.SmartGroupClashesInterface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinHeight="560"
             MinWidth="420"
             FontFamily="Arial"
             Background="#FFE5EAF1">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartGroupClashes;component/Styles/SmartPluginTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource PluginBrush.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PluginHeaderBorderStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource PluginHeaderTitleStyle}"
                           Text="Smart Group Clashes" />
                <TextBlock Style="{StaticResource PluginHeaderDescriptionStyle}"
                           Text="Группировка пересечений по выбранным критериям." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,0,14,0">
            <StackPanel>
                <Border x:Name="clashTestGroupBox" Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Тесты коллизий" />
                        <Grid Grid.Row="0" Margin="0,28,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="SearchTextBox"
                                         Margin="0"
                                         VerticalAlignment="Center"
                                         ToolTip="Введите текст для фильтрации тестов"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Найти проверку"
                                           Foreground="Gray"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="" />
                                                        <Condition Binding="{Binding ElementName=SearchTextBox, Path=IsKeyboardFocusWithin}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Выбрать всё"
                                        MinWidth="100"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="0,0,6,0"
                                        Command="{Binding SelectAllTestsCommand}" />
                                <Button Content="Снять выбор"
                                        MinWidth="100"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="0"
                                        Command="{Binding ClearSelectionCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{StaticResource PluginBrush.Field}"
                                BorderBrush="{StaticResource PluginBrush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ListBox x:Name="ClashTestListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding ClashTests}"
                                     SelectionMode="Extended">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Margin="6,3"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="0,10,0,0">
                            <Label Content="{Binding SelectedTestsCountText}" Padding="0" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Label Content="{Binding SelectedTestDisplayName}"
                                   ContentStringFormat="Тест коллизий: {0}"
                                   Padding="0" />
                            <Label Content="{Binding SelectionAName}"
                                   ContentStringFormat="Выбор A: {0}"
                                   Padding="0" />
                            <Label Content="{Binding SelectionBName}"
                                   ContentStringFormat="Выбор B: {0}"
                                   Padding="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="methodGroupBox" Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Режим группировки" />
                        <Label Grid.Column="0" Grid.Row="1" Content="Группировать по:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Grid.Row="1"
                                  IsEnabled="{Binding AreComboBoxesEnabled}"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding GroupByList}"
                                  SelectedItem="{Binding SelectedGroupBy}" />
                        <Label Grid.Column="0" Grid.Row="2" Content="Затем по:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Grid.Row="2"
                                  IsEnabled="{Binding AreComboBoxesEnabled}"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding GroupThenList}"
                                  SelectedItem="{Binding SelectedThenBy}" />
                        <Label Grid.Column="0" Grid.Row="3" Content="И затем по:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Grid.Row="3"
                                  IsEnabled="{Binding AreComboBoxesEnabled}"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding GroupThirdList}"
                                  SelectedItem="{Binding SelectedThirdBy}" />
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                    Visibility="{Binding IsCustomPropertyParamsVisible, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource PluginMutedTextStyle}"
                                       Margin="0,0,0,8"
                                       Text="Для каждого этапа, где выбрано «Своё свойство»: укажите отображаемое имя параметра для выбора A и B, как в свойствах Navisworks." />
                            <StackPanel Visibility="{Binding IsCustomPropertyStage1Visible, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Первый уровень («Группировать по»)" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Параметр (A):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage1A, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}" Margin="0,0,0,4"
                                              ToolTip="Выбор A — первый элемент пары пересечения" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="Параметр (B):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage1B, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}"
                                              ToolTip="Выбор B — второй элемент пары пересечения" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsCustomPropertyStage2Visible, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Второй уровень («Затем по»)" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Параметр (A):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage2A, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}" Margin="0,0,0,4"
                                              ToolTip="Выбор A — первый элемент пары пересечения" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="Параметр (B):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage2B, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}"
                                              ToolTip="Выбор B — второй элемент пары пересечения" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsCustomPropertyStage3Visible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Третий уровень («И затем по»)" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Параметр (A):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage3A, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}" Margin="0,0,0,4"
                                              ToolTip="Выбор A — первый элемент пары пересечения" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="Параметр (B):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage3B, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}"
                                              ToolTip="Выбор B — второй элемент пары пересечения" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PluginCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Дополнительные параметры" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding KeepExistingGroups}" VerticalAlignment="Center" />
                            <Label Content="Сохранить существующие группы" Padding="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding SkipFixedGroups}" VerticalAlignment="Center" />
                            <TextBlock Text="Не создавать группу, если все пересечения в группе исправлены"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4,2,0,2" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                            <TextBlock Text="Группировать только статусы:" Margin="0,0,0,4" />
                            <WrapPanel>
                                <CheckBox Content="Новые" IsChecked="{Binding AnalyzeNewStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Активные" IsChecked="{Binding AnalyzeActiveStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Проверенные" IsChecked="{Binding AnalyzeReviewedStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Утверждённые" IsChecked="{Binding AnalyzeApprovedStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Устранённые" IsChecked="{Binding AnalyzeResolvedStatus}" Margin="0,0,8,0" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#66FFFFFF"
                BorderBrush="{StaticResource PluginBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Сохранить настройки"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Command="{Binding SaveSettingsCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Группировать" IsDefault="True"
                            Command="{Binding GroupCommand}" />
                    <Button Content="Разгруппировать"
                            Command="{Binding UngroupCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

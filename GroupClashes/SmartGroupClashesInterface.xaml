<UserControl x:Class="SmartGroupClashes.SmartGroupClashesInterface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinHeight="560"
             MinWidth="420"
             FontFamily="Arial"
             Background="#FFE5EAF1">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartGroupClashes;component/Styles/SmartPluginTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource PluginBrush.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PluginHeaderBorderStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource PluginHeaderTitleStyle}"
                           Text="Smart Group Clashes" />
                <TextBlock Style="{StaticResource PluginHeaderDescriptionStyle}"
                           Text="Группировка пересечений по выбранным критериям." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,0,14,0">
            <StackPanel>
                <Border x:Name="clashTestGroupBox" Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Тесты коллизий" />
                        <Grid Grid.Row="0" Margin="0,28,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="SearchTextBox"
                                         Margin="0"
                                         VerticalAlignment="Center"
                                         ToolTip="Введите текст для фильтрации тестов"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Найти проверку"
                                           Foreground="Gray"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="" />
                                                        <Condition Binding="{Binding ElementName=SearchTextBox, Path=IsKeyboardFocusWithin}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Выбрать всё"
                                        MinWidth="100"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="0,0,6,0"
                                        Command="{Binding SelectAllTestsCommand}" />
                                <Button Content="Снять выбор"
                                        MinWidth="100"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="0"
                                        Command="{Binding ClearSelectionCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{StaticResource PluginBrush.Field}"
                                BorderBrush="{StaticResource PluginBrush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TreeView x:Name="ClashTestTreeView"
                                      Background="Transparent" BorderThickness="0"
                                      MinHeight="160" MaxHeight="300"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ItemsSource="{Binding ClashTestTree}">
                                <TreeView.Resources>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ToggleButton x:Name="Expander" Width="16" Height="22"
                                                                      Focusable="False" VerticalAlignment="Top"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent">
                                                                        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8 Z"
                                                                              Fill="#687482" Width="8" Height="8" Stretch="Uniform"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,4 Z" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <Border x:Name="HeaderBorder" Grid.Column="1" Background="Transparent" CornerRadius="3">
                                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                                              HorizontalAlignment="Stretch" />
                                                        </Border>
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#E6F2F8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsThreeState="False" Margin="2,3"
                                                  ToolTip="Выбрать проверку или все видимые проверки ветки">
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </CheckBox>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="0,10,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Развернуть всё" Command="{Binding ExpandTreeCommand}" Padding="8,2" />
                                <Button Content="Свернуть всё" Command="{Binding CollapseTreeCommand}" Padding="8,2" />
                                <Button Content="Обновить список" Command="{Binding RefreshTestsCommand}" Padding="8,2" />
                            </WrapPanel>
                            <TextBlock Text="{Binding TestsLoadStatus}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding TestsLoadError}" Foreground="#B42318"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="Группы по началу имени: ВИС_ВИС, ВИС_АР, ВИС_КР, АР_АР. Нераспознанные названия — в «Нераспределенных». Флажок ветки выбирает все её проверки, соответствующие поиску."
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Проверки не найдены. Очистите поиск или нажмите «Обновить список»."
                                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClashTestTree.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Label Content="{Binding SelectedTestsCountText}" Padding="0" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Label Content="{Binding SelectedTestDisplayName}"
                                   ContentStringFormat="Тест коллизий: {0}"
                                   Padding="0" />
                            <Label Content="{Binding SelectionAName}"
                                   ContentStringFormat="Выбор A: {0}"
                                   Padding="0" />
                            <Label Content="{Binding SelectionBName}"
                                   ContentStringFormat="Выбор B: {0}"
                                   Padding="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="methodGroupBox" Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Режим группировки" />
                        <Label Grid.Column="0" Grid.Row="1" Content="Группировать по:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Grid.Row="1"
                                  IsEnabled="{Binding AreComboBoxesEnabled}"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding GroupByList}"
                                  SelectedItem="{Binding SelectedGroupBy}" />
                        <Label Grid.Column="0" Grid.Row="2" Content="Затем по:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Grid.Row="2"
                                  IsEnabled="{Binding AreComboBoxesEnabled}"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding GroupThenList}"
                                  SelectedItem="{Binding SelectedThenBy}" />
                        <Label Grid.Column="0" Grid.Row="3" Content="И затем по:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Grid.Row="3"
                                  IsEnabled="{Binding AreComboBoxesEnabled}"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding GroupThirdList}"
                                  SelectedItem="{Binding SelectedThirdBy}" />
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                    Visibility="{Binding IsCustomPropertyParamsVisible, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource PluginMutedTextStyle}"
                                       Margin="0,0,0,8"
                                       Text="Для каждого этапа, где выбрано «Своё свойство»: укажите отображаемое имя параметра для выбора A и B, как в свойствах Navisworks." />
                            <StackPanel Visibility="{Binding IsCustomPropertyStage1Visible, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Первый уровень («Группировать по»)" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Параметр (A):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage1A, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}" Margin="0,0,0,4"
                                              ToolTip="Выбор A — первый элемент пары пересечения" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="Параметр (B):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage1B, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}"
                                              ToolTip="Выбор B — второй элемент пары пересечения" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsCustomPropertyStage2Visible, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Второй уровень («Затем по»)" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Параметр (A):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage2A, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}" Margin="0,0,0,4"
                                              ToolTip="Выбор A — первый элемент пары пересечения" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="Параметр (B):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage2B, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}"
                                              ToolTip="Выбор B — второй элемент пары пересечения" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsCustomPropertyStage3Visible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Третий уровень («И затем по»)" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Параметр (A):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage3A, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}" Margin="0,0,0,4"
                                              ToolTip="Выбор A — первый элемент пары пересечения" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="Параметр (B):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                              Text="{Binding CustomPropertyStage3B, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding CustomPropertySuggestions}"
                                              ToolTip="Выбор B — второй элемент пары пересечения" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PluginCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Дополнительные параметры" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding KeepExistingGroups}" VerticalAlignment="Center" />
                            <Label Content="Сохранить существующие группы" Padding="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding SkipFixedGroups}" VerticalAlignment="Center" />
                            <TextBlock Text="Не создавать группу, если все пересечения в группе исправлены"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4,2,0,2" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                            <TextBlock Text="Группировать только статусы:" Margin="0,0,0,4" />
                            <WrapPanel>
                                <CheckBox Content="Новые" IsChecked="{Binding AnalyzeNewStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Активные" IsChecked="{Binding AnalyzeActiveStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Проверенные" IsChecked="{Binding AnalyzeReviewedStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Утверждённые" IsChecked="{Binding AnalyzeApprovedStatus}" Margin="0,0,8,0" />
                                <CheckBox Content="Устранённые" IsChecked="{Binding AnalyzeResolvedStatus}" Margin="0,0,8,0" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PluginCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginSectionTitleStyle}"
                                   Text="Исключение труб ВИС" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="Допустимое расстояние, мм:" Target="{Binding ElementName=ExclusionDistanceInput}"
                                   VerticalAlignment="Center" Padding="0,0,8,0" />
                            <TextBox x:Name="ExclusionDistanceInput" Width="96"
                                     Text="{Binding ExclusionDistanceMmText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Положительное число в миллиметрах. Можно использовать запятую или точку." />
                        </StackPanel>
                        <TextBlock Text="{Binding ExclusionDistanceError}" Foreground="#B42318"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Измеряется между центрами габаритов, как приближение расстояния между осями. Порог задаёт расстояние для пары труб и радиус поиска соседей. Для сохранения нажмите «Сохранить настройки»."
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <CheckBox IsChecked="{Binding IncludeSinglePipeExclusion}" Margin="0,0,0,6">
                            <TextBlock Text="Также утверждать: одиночная труба ВИС диаметром меньше 50 мм и второй элемент из модели ВИС, если в заданном радиусе нет других труб."
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Имя файла модели второго участника должно содержать VK, EOM, SS, OV, ВК, ЕОМ, СС или ОМ без учёта регистра. Код в имени папки или самого элемента не учитывается."
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Соседями считаются трубы любого диаметра и раздела из всей открытой модели. Расстояние до соседа, равное указанному порогу или меньше, блокирует правило одиночной трубы; сама труба не учитывается."
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Правило пары труб (если опция выше выключена): обе трубы ВИС, категория «Трубы» во вкладке «Объект», диаметр строго меньше 50 мм."
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Труба ВИС: во вкладке «Элемент» трубы или её родителей значение содержит VK, EOM, SS, OV, ВК, ЕОМ, СС или ОМ. Регистр не учитывается."
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Для пары труб: расстояние между центрами габаритов должно быть строго меньше указанного порога."
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Команда меняет только статус на «Утверждено» в выбранных тестах, включая коллизии внутри групп. Утверждённые, устранённые и коллизии с неполными данными пропускаются. Фильтр статусов группировки здесь не применяется."
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="Утвердить по правилу"
                                HorizontalAlignment="Left"
                                Command="{Binding ExcludePipeClashesCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#66FFFFFF"
                BorderBrush="{StaticResource PluginBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Сохранить настройки"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Command="{Binding SaveSettingsCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Группировать" IsDefault="True"
                            Command="{Binding GroupCommand}" />
                    <Button Content="Разгруппировать"
                            Command="{Binding UngroupCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
